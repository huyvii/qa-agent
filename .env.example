GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_RETRIES=2

# Tùy chọn: yêu cầu mật khẩu khi mở app (hữu ích khi đưa link cho người khác)
# APP_PASSWORD=doi_mat_khau

# Tùy chọn: ghi đè đường dẫn lưu trữ (hữu ích khi mount volume trong Docker)
# CHROMA_DIR=./chroma_db
# CHAT_DB_PATH=chat_history.db

# Tùy chọn: đổi cross-encoder reranker (mặc định mmarco-mMiniLMv2-L12-H384-v1 đa ngữ, nhẹ cho CPU;
# nếu chạy trên máy có GPU mạnh có thể nâng lên BAAI/bge-reranker-v2-m3)
# RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
