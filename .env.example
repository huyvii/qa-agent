GOOGLE_API_KEY=your_gemini_api_key_here

# Tùy chọn: yêu cầu mật khẩu khi mở app (hữu ích khi đưa link cho người khác)
# APP_PASSWORD=doi_mat_khau

# Tùy chọn: ghi đè đường dẫn lưu trữ (hữu ích khi mount volume trong Docker)
# CHROMA_DIR=./chroma_db
# CHAT_DB_PATH=chat_history.db

# Tùy chọn: đổi reranker (mặc định BAAI/bge-reranker-base, nhẹ cho CPU)
# RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
